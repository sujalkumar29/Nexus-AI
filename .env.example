# Server Port
PORT=3001

# Database Configuration (SQLite Prisma)
DATABASE_URL="file:./dev.db"

# Model Context Protocol (MCP) Server URL (Streamable HTTP, Spec 2025-11-25+)
MCP_SERVER_URL="http://localhost:3001/mcp"

# Node Environment
NODE_ENV=development

# Optional External AI API Key (If not provided, high-fidelity local models & embeddings are used)
# OPENAI_API_KEY=
