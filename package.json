{
  "name": "nexus-ai",
  "version": "1.0.0",
  "description": "Nexus AI — One Conversation. Multiple Actions. Built for Amazon Developer Hackathon 2026 (Alexa+ track).",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "mcp": "tsx src/mcp/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx src/db/seed.ts",
    "test": "tsx --test src/tests/*.test.ts"
  },
  "keywords": [
    "alexa-plus",
    "mcp",
    "rag",
    "ai-agent",
    "hackathon-2026"
  ],
  "author": "Nexus AI Team",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.1",
    "@types/pdf-parse": "^1.1.4",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
